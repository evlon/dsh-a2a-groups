# Ignore generated and machine-specific files.
node_modules/
.pnpm-store/

# Screenshots captured during verification; they are evidence, not source.
.shots/

# Runtime state and logs from the dev instances.
*.log
out.log
err.log

# OS noise
.DS_Store
Thumbs.db
desktop.ini

# A separate repository cloned alongside this one; not part of this tree.
dsh-session-bus/


# My own commit-message scratch file; not part of the project.
.git-msg.txt

# Local verification reports are written to .shots/ (already ignored) — but keep this
# pattern in case one is ever copied out.
*-REPORT.md
.npmrc-publish

# ---------------------------------------------------------------------------
# One-off probe scripts written while driving the UI through opencli.
#
# 72 of these had accumulated in the repository root and were all COMMITTED: chk.js,
# probe2.js, click-allow.js, measure.js and so on. They were scratch files that answered
# one question each, and they made the tree look like it contained 70 source files that
# nobody could account for.
#
# Any such script now belongs under .shots/ (ignored) or %TEMP%. The root of this
# repository holds docs and the two package directories, nothing else.
#
# The `dsh-a2a/` package keeps its own real sources, so this pattern is anchored to the
# root with a leading slash and only matches a single path segment.
/*.js
/*.mjs

# Decompressed session logs pulled out for forensics.
sess-unzip/
