{
  "name": "dsh-a2a-groups",
  "version": "0.1.38",
  "description": "A2A protocol for DSH: expose a DSH Session as a standard A2A agent, call remote A2A agents, and run invite-only collaboration groups where a group is itself an A2A agent behind a gateway.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "a2a",
    "agent-to-agent",
    "session",
    "collaboration"
  ],
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "bin": {
    "agent-groups": "bin/agent-groups.js",
    "agent-groups-mcp": "lib/mcp-server.js"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./client.js"
    },
    "./mcp": "./lib/mcp-server.js",
    "./host": "./bin/agent-groups.js",
    "./specs": "./lib/shared/tool-specs.js",
    "./runtime": "./lib/shared/tool-runtime.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./core/groups": "./lib/core/groups.js",
    "./core/memberships": "./lib/core/memberships.js",
    "./core/wire": "./lib/core/wire.js"
  },
  "files": [
    "bin",
    "lib",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "README-ui.md",
    "docs",
    "CHANGELOG.md",
    "opencli-adapter",
    "scripts"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run --exclude=\"**/*.slow.mjs\"",
    "test:3port": "node scripts/local-3port-check.mjs",
    "test:all": "vitest run",
    "test:watch": "vitest --exclude=\"**/*.slow.mjs\"",
    "test:coverage": "node scripts/coverage.mjs --check",
    "strip:invisible": "node scripts/strip-invisible.mjs client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots",
        "@deepseek-ai/dsh-client-connection/client"
      ]
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/evlon/dsh-a2a-groups.git",
    "directory": "dsh-a2a"
  },
  "bugs": {
    "url": "https://github.com/evlon/dsh-a2a-groups/issues"
  },
  "homepage": "https://github.com/evlon/dsh-a2a-groups#readme",
  "author": "evlon"
}
